//@version=6
indicator("Spike Mean Reversion v4", overlay=false)

// ── Band/RSI score inputs (from original) ──
bbLength = input.int(20, "BB Lookback", group="Band Score")
bbMult = input.float(2.25, "BB Sigma", group="Band Score")
rsiLength = input.int(14, "RSI Lookback", group="Band Score")
bandVolLength = input.int(14, "Volume Ratio Lookback", group="Band Score")
bandAtrLength = input.int(14, "ATR Ratio Lookback", group="Band Score")
bandVolThreshold = input.float(1.75, "Volume Ratio Threshold", group="Band Score")
bandAtrThreshold = input.float(3.0, "ATR Ratio Threshold", group="Band Score")

// ── Robust z-score inputs (from v2) ──
zLength = input.int(20, "Z-Score Lookback", group="Robust Z Score")
zRangeLength = input.int(14, "Range Ratio Lookback", group="Robust Z Score")
zRangeGap = input.int(3, "Range Ratio Gap (bars excluded)", group="Robust Z Score")
zVolLength = input.int(60, "Volume Ratio Lookback", group="Robust Z Score")
zThreshold = input.float(2.25, "Z-Score Threshold", group="Robust Z Score")
zRangeThreshold = input.float(3.0, "Range Ratio Threshold", group="Robust Z Score")
zVolThreshold = input.float(1.75, "Volume Ratio Threshold", group="Robust Z Score")

// ── Alert threshold (fraction of own max, 0–1) ──
alertLevel = input.float(0.75, "Alert Strength (0-1)", minval=0.0, maxval=1.0, group="Alerts")

// ── Band/RSI score (gated, raw max 4) ──
bbBasis = ta.sma(close, bbLength)
bbDev = bbMult * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
pctB = (close - bbLower) / (bbUpper - bbLower)

rsi = ta.rsi(close, rsiLength)

bandAvgVolume = ta.sma(volume, bandVolLength)
bandVolRatio = bandAvgVolume > 0 ? volume / bandAvgVolume : 0.0

bandAtrValue = ta.atr(bandAtrLength)
barRange = high - low
bandAtrRatio = bandAtrValue > 0 ? barRange / bandAtrValue : 0.0

bandScore = 0
isUpper = false
isLower = false

if pctB >= 1.0
    isUpper := true
    bandScore := 1
    if rsi >= 70.0
        bandScore := 2
        if bandVolRatio >= bandVolThreshold
            bandScore += 1
        if bandAtrRatio >= bandAtrThreshold
            bandScore += 1
else if pctB <= 0.0
    isLower := true
    bandScore := 1
    if rsi <= 30.0
        bandScore := 2
        if bandVolRatio >= bandVolThreshold
            bandScore += 1
        if bandAtrRatio >= bandAtrThreshold
            bandScore += 1

// ── Robust z-score (median/MAD, gapped range baseline, raw max 3) ──
logReturn = math.log(close / close[1])
retMedian = ta.median(logReturn, zLength)
absDev = math.abs(logReturn - retMedian)
mad = ta.median(absDev, zLength)
zScore = mad > 0 ? (logReturn - retMedian) / (1.4826 * mad) : 0.0

trueRange = ta.tr(true)
rangeBaseline = ta.sma(trueRange, zRangeLength)[zRangeGap]
zRangeRatio = rangeBaseline > 0 ? barRange / rangeBaseline : 0.0

zAvgVolume = ta.sma(volume, zVolLength)
zVolRatio = zAvgVolume > 0 ? volume / zAvgVolume : 0.0

zPass = math.abs(zScore) >= zThreshold
zRangePass = zRangeRatio >= zRangeThreshold
zVolPass = zVolRatio >= zVolThreshold

zScoreFinal = 0
if zPass
    zScoreFinal += 1
if zRangePass
    zScoreFinal += 1
if zPass and zRangePass and zVolPass
    zScoreFinal += 1

// ── Normalize each to fraction of its own max, then take the max ──
bandStrength = bandScore / 4.0
zStrength = zScoreFinal / 3.0
strength = math.max(bandStrength, zStrength)

zIsUp = zScore >= 0
// On a tie, default to the robust-z direction.
winnerIsUp = zStrength >= bandStrength ? zIsUp : isUpper

// Color: 4 saturation tiers across the 0–1 strength range.
color barColor = na
if strength <= 0.0
    barColor := na
else
    transp = strength >= 1.0 ? 0 : strength >= 0.75 ? 25 : strength >= 0.5 ? 50 : 70
    barColor := winnerIsUp ? color.new(color.red, transp) : color.new(color.blue, transp)

plot(strength, "Spike Strength", style=plot.style_histogram, color=barColor, linewidth=4)
hline(0, "Zero", color=color.gray, linestyle=hline.style_solid)
hline(1, "Max", color=color.new(color.gray, 100))

alertcondition(strength >= alertLevel and winnerIsUp, "Bullish Spike", "Bullish spike strength >= alert level")
alertcondition(strength >= alertLevel and not winnerIsUp, "Bearish Spike", "Bearish spike strength >= alert level")
alertcondition(strength >= alertLevel, "Any Spike", "Spike strength >= alert level")
