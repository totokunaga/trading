//@version=6
indicator("Spike Mean Reversion v2", overlay=false)

zLength = input.int(20, "Z-Score Lookback")
atrLength = input.int(14, "Range Ratio Lookback")
atrGap = input.int(3, "Range Ratio Gap (bars excluded)")
volLength = input.int(60, "Volume Ratio Lookback")
zThreshold = input.float(2.25, "Z-Score Threshold")
atrThreshold = input.float(3.0, "Range Ratio Threshold")
volThreshold = input.float(1.75, "Volume Ratio Threshold")

// Robust z-score: median/MAD resist outliers, so a prior spike in the
// window does not inflate the denominator and mask later spikes.
logReturn = math.log(close / close[1])
retMedian = ta.median(logReturn, zLength)
absDev = math.abs(logReturn - retMedian)
mad = ta.median(absDev, zLength)
zScore = mad > 0 ? (logReturn - retMedian) / (1.4826 * mad) : 0.0

// Gapped baseline: the SMA window ends `atrGap` bars before the current bar,
// so neither this spike nor the recent cluster contaminates the baseline.
trueRange = ta.tr(true)
rangeBaseline = ta.sma(trueRange, atrLength)[atrGap]
barRange = high - low
atrRatio = rangeBaseline > 0 ? barRange / rangeBaseline : 0.0

avgVolume = ta.sma(volume, volLength)
volRatio = avgVolume > 0 ? volume / avgVolume : 0.0

zPass = math.abs(zScore) >= zThreshold
atrPass = atrRatio >= atrThreshold
volPass = volRatio >= volThreshold

score = 0
if zPass
    score += 1
if atrPass
    score += 1
if zPass and atrPass and volPass
    score += 1

isUp = zScore >= 0

color barColor = na
if score == 0
    barColor := na
else if isUp
    barColor := switch score
        1 => color.new(color.red, 70)
        2 => color.new(color.red, 35)
        => color.red
else
    barColor := switch score
        1 => color.new(color.blue, 70)
        2 => color.new(color.blue, 35)
        => color.blue

plot(score, "Spike Score", style=plot.style_histogram, color=barColor, linewidth=4)
hline(0, "Zero", color=color.gray, linestyle=hline.style_solid)
hline(3, "", color=color.new(color.gray, 100))

alertcondition(score >= 2 and isUp, "Bullish Spike (2+)", "Positive z-score spike score >= 2")
alertcondition(score >= 2 and not isUp, "Bearish Spike (2+)", "Negative z-score spike score >= 2")
alertcondition(score >= 2, "Any Spike (2+)", "Spike score >= 2")
