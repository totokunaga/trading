//@version=6
indicator("Spike Mean Reversion v5", overlay=false)

// Two independent spike detectors, each normalized to a 0–1 strength:
//   • Stretch — price closed far from its mean (Bollinger band + RSI). Good for
//     slow grinds into overbought/oversold.
//   • Impulse — a single bar moved violently (robust return z-score). Good for
//     sudden flash moves / news candles.
// Final strength = the stronger of the two (math.max), same as v4.

// ── Stretch detector: price far from the mean ──
stretchBandLength = input.int(20, "Bollinger Lookback", group="Stretch (price far from mean)")
stretchBandSigma = input.float(2.25, "Bollinger Sigma", group="Stretch (price far from mean)")
stretchRsiLength = input.int(14, "RSI Lookback", group="Stretch (price far from mean)")
stretchVolumeLength = input.int(14, "Volume Avg Lookback", group="Stretch (price far from mean)")
stretchRangeLength = input.int(14, "ATR Lookback", group="Stretch (price far from mean)")
stretchVolumeThreshold = input.float(1.75, "Volume Ratio Threshold", group="Stretch (price far from mean)")
stretchRangeThreshold = input.float(3.0, "Range/ATR Ratio Threshold", group="Stretch (price far from mean)")

// ── Impulse detector: violent single-bar move ──
impulseLength = input.int(20, "Return Z-Score Lookback", group="Impulse (single-bar shock)")
impulseRangeLength = input.int(14, "Range Baseline Lookback", group="Impulse (single-bar shock)")
impulseRangeGap = input.int(3, "Range Baseline Gap (bars excluded)", group="Impulse (single-bar shock)")
impulseVolumeLength = input.int(60, "Volume Avg Lookback", group="Impulse (single-bar shock)")
impulseZThreshold = input.float(2.25, "Return Z-Score Threshold", group="Impulse (single-bar shock)")
impulseRangeThreshold = input.float(3.0, "Range Ratio Threshold", group="Impulse (single-bar shock)")
impulseVolumeThreshold = input.float(1.75, "Volume Ratio Threshold", group="Impulse (single-bar shock)")

// ── Alert threshold (fraction of full strength, 0–1) ──
alertLevel = input.float(0.75, "Alert Strength (0-1)", minval=0.0, maxval=1.0, group="Alerts")

barRange = high - low

// ── Stretch score (gated, raw max 4) ──
// Score climbs only as deeper confirmation appears: band touch → RSI extreme →
// then volume and range surges can each add a point.
bandBasis = ta.sma(close, stretchBandLength)
bandDev = stretchBandSigma * ta.stdev(close, stretchBandLength)
bandUpper = bandBasis + bandDev
bandLower = bandBasis - bandDev
pctB = (close - bandLower) / (bandUpper - bandLower)

stretchRsi = ta.rsi(close, stretchRsiLength)

stretchAvgVolume = ta.sma(volume, stretchVolumeLength)
stretchVolumeRatio = stretchAvgVolume > 0 ? volume / stretchAvgVolume : 0.0

stretchAtr = ta.atr(stretchRangeLength)
stretchRangeRatio = stretchAtr > 0 ? barRange / stretchAtr : 0.0

stretchScore = 0
atUpperBand = false
atLowerBand = false

if pctB >= 1.0
    atUpperBand := true
    stretchScore := 1
    if stretchRsi >= 70.0
        stretchScore := 2
        if stretchVolumeRatio >= stretchVolumeThreshold
            stretchScore += 1
        if stretchRangeRatio >= stretchRangeThreshold
            stretchScore += 1
else if pctB <= 0.0
    atLowerBand := true
    stretchScore := 1
    if stretchRsi <= 30.0
        stretchScore := 2
        if stretchVolumeRatio >= stretchVolumeThreshold
            stretchScore += 1
        if stretchRangeRatio >= stretchRangeThreshold
            stretchScore += 1

// ── Impulse score (median/MAD z-score, gapped range baseline, raw max 3) ──
// Robust statistics so a recent spike in the window does not mask later ones.
logReturn = math.log(close / close[1])
returnMedian = ta.median(logReturn, impulseLength)
absDeviation = math.abs(logReturn - returnMedian)
mad = ta.median(absDeviation, impulseLength)
impulseZ = mad > 0 ? (logReturn - returnMedian) / (1.4826 * mad) : 0.0

// Range baseline ends `impulseRangeGap` bars back so the current spike cluster
// does not contaminate the denominator.
trueRange = ta.tr(true)
impulseRangeBaseline = ta.sma(trueRange, impulseRangeLength)[impulseRangeGap]
impulseRangeRatio = impulseRangeBaseline > 0 ? barRange / impulseRangeBaseline : 0.0

impulseAvgVolume = ta.sma(volume, impulseVolumeLength)
impulseVolumeRatio = impulseAvgVolume > 0 ? volume / impulseAvgVolume : 0.0

impulseZPass = math.abs(impulseZ) >= impulseZThreshold
impulseRangePass = impulseRangeRatio >= impulseRangeThreshold
impulseVolumePass = impulseVolumeRatio >= impulseVolumeThreshold

impulseScore = 0
if impulseZPass
    impulseScore += 1
if impulseRangePass
    impulseScore += 1
if impulseZPass and impulseRangePass and impulseVolumePass
    impulseScore += 1

// ── Combine: normalize each to its own max, take the stronger ──
stretchStrength = stretchScore / 4.0
impulseStrength = impulseScore / 3.0
strength = math.max(stretchStrength, impulseStrength)

impulseIsUp = impulseZ >= 0
// On a tie, default to the impulse direction.
winnerIsUp = impulseStrength >= stretchStrength ? impulseIsUp : atUpperBand

// Color: 4 saturation tiers across the 0–1 strength range. Red = up, Blue = down.
color barColor = na
if strength <= 0.0
    barColor := na
else
    transp = strength >= 1.0 ? 0 : strength >= 0.75 ? 25 : strength >= 0.5 ? 50 : 70
    barColor := winnerIsUp ? color.new(color.red, transp) : color.new(color.blue, transp)

plot(strength, "Spike Strength", style=plot.style_histogram, color=barColor, linewidth=4)
hline(0, "Zero", color=color.gray, linestyle=hline.style_solid)
hline(1, "Max", color=color.new(color.gray, 100))

alertcondition(strength >= alertLevel and winnerIsUp, "Bullish Spike", "Bullish spike strength >= alert level")
alertcondition(strength >= alertLevel and not winnerIsUp, "Bearish Spike", "Bearish spike strength >= alert level")
alertcondition(strength >= alertLevel, "Any Spike", "Spike strength >= alert level")
